# Public HTTPS origin for real GitHub setup. Local demo needs no configuration.
BUILDFERRY_PUBLIC_URL=http://localhost:8787
# For a local Node installation only; the container always uses /data.
BUILDFERRY_DATA_DIR=.data
# Optional for a local Node installation: a base64-encoded 32-byte key.
# Otherwise BuildFerry creates credentials.key in its persistent data directory.
# Keep the original key and database together when restoring, with separate backups.
# BUILDFERRY_ENCRYPTION_KEY=
